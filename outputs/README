      |-Prostate-MRI-US-Biopsy-0021
          |-axial_view.png 
          |-biopsy_tracks.csv 
          |-biopsy_visualization.html 
          |-biopsy_visualization.png 
          |-biopsy_visualization_mesh_only.html 
          |-biopsy_visualization_mesh_only.png 
          |-combined_summary.png 
          |-coronal_view.png 
          |-highest_bvalue_series.nii.gz 
          |-sagittal_view.png
      |-*
